{
  "name": "User",
  "type": "object",
  "properties": {
    "username": {
      "type": "string",
      "description": "User handle"
    },
    "email": {
      "type": "string",
      "description": "User email address"
    },
    "password": {
      "type": "string",
      "description": "User account password"
    },
    "role": {
      "type": "string",
      "description": "The role of the user in the app",
      "enum": [
        "admin",
        "user"
      ]
    }
  },
  "required": [
    "username",
    "email",
    "password",
    "role"
  ],
  "permissions": {
    "create": "public",
    "read": "public",
    "update": "owner",
    "delete": "admin"
  }
}

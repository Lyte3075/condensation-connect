{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "description": "The role of the user in the app",
      "enum": [
        "admin",
        "user"
      ]
    }
  },
  "required": [
    "role"
  ],
  "permissions": {
    "create": "public",
    "read": "public",
    "update": "owner",
    "delete": "admin"
  }
}
